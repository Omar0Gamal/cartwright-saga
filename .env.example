# Cartwright environment variables
# Copy to .env and fill in values for local development.

# Orchestrator
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orchestrator?sslmode=disable
BILLING_ADDR=localhost:50051
NATS_URL=nats://localhost:4222
LEASE_SECONDS=15

# Billing
# DATABASE_URL for billing uses a different format (Npgsql connection string):
# DATABASE_URL=Host=localhost;Port=5432;Database=billing;Username=postgres;Password=postgres

# Compose
POSTGRES_PASSWORD=postgres

# Fault injection (test only — never set in production or Helm values)
# CARTWRIGHT_FAULTS=1
